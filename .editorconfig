# EditorConfig: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt uses tabs
[*.go]
indent_style = tab
indent_size = 4

# Make recipes require tabs
[Makefile]
indent_style = tab

[*.{html,css,svg,yml,yaml,json,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
